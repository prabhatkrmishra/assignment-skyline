{
  "name": "skyline-real-estate-showcase",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/prepare-db.ts && tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "analyze": "next experimental-analyze --output"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "^0.186.1",
    "zod": "^4.1.12",
    "sharp": "^0.35.5",
    "@next/env": "16.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.30",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "eslint": "^10.0.0",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5",
    "@tailwindcss/postcss": "^4.3.3",
    "vite": "^8.0.0"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "unrs-resolver@1.12.2": true,
    "better-sqlite3@13.0.3": true
  }
}
