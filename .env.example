# SQLite database location. Keep it on a persistent local filesystem on the VPS.
DATABASE_URL=file:./data/skyline.sqlite
# Optional: set a long random string before enabling the protected admin route.
ADMIN_PASSWORD=
# Set a public base URL for canonical metadata when available.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional salt for privacy-preserving IP hashes used by the SQLite rate limiter.
RATE_LIMIT_SALT=replace-with-a-long-random-value
